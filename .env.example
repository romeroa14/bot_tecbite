# PostgreSQL Database
DB_HOST=n8n.yavingos.com
DB_PORT=5433
DB_NAME=n8ntecbite_db
DB_USER=postgres
DB_PASS=your_db_password_here

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Instagram / Meta Graph API
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token-here
INSTAGRAM_VERIFY_TOKEN=your-custom-verify-token-here

# Optional: Slack webhook for handoff notifications
# SLACK_HANDOFF_WEBHOOK_URL=https://hooks.slack.com/services/...

# Telegram Ops Bot (marketing group monitoring)
# Create bot via @BotFather, add to private group, run scripts/telegram_ops_get_chat_id.sh
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_IDS=
# Comma-separated Telegram user IDs allowed to run /commands (empty = all in group)
TELEGRAM_OPS_ALLOWED_USER_IDS=
TELEGRAM_OPS_POLL_TIMEOUT=25
